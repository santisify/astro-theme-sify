{
  "name": "astro-theme-sify",
  "type": "module",
  "version": "0.1.0",
  "description": "基于 Astro 7 + TypeScript + UnoCSS 的个人博客主题",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "PLAYWRIGHT_BROWSERS_PATH=\"$PWD/.playwright\" astro dev",
    "build": "PLAYWRIGHT_BROWSERS_PATH=\"$PWD/.playwright\" astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "tsc --noEmit",
    "browsers:install": "PLAYWRIGHT_BROWSERS_PATH=\"$PWD/.playwright\" playwright install chromium",
    "postinstall": "PLAYWRIGHT_BROWSERS_PATH=\"$PWD/.playwright\" playwright install chromium"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.2",
    "katex": "^0.18.4",
    "playwright": "^1.62.1",
    "rehype-katex": "7",
    "rehype-mermaid": "3",
    "remark-math": "6"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@unocss/astro": "^66.7.5",
    "@unocss/preset-attributify": "^66.7.5",
    "@unocss/preset-wind4": "^66.7.5",
    "typescript": "7.0",
    "unocss": "^66.7.5"
  }
}
