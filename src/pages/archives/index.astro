---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entryPath } from '../../utils/content';

type YearGroup = {
  year: string;
  months: {
    month: string;
    monthNum: number;
    posts: { slug: string; title: string; pubDate: Date }[];
  }[];
};

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sorted = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const yearMap = new Map<string, Map<number, typeof sorted>>();
for (const post of sorted) {
  const date = post.data.pubDate;
  const year = date.getFullYear().toString();
  const month = date.getMonth();
  if (!yearMap.has(year)) yearMap.set(year, new Map());
  const monthMap = yearMap.get(year)!;
  if (!monthMap.has(month)) monthMap.set(month, []);
  monthMap.get(month)!.push({
    slug: entryPath(post.id),
    title: post.data.title,
    pubDate: date,
  });
}

const monthNames = ['一月', '二月', '三月', '四月', '五月', '六月', '七月', '八月', '九月', '十月', '十一月', '十二月'];

const years: YearGroup[] = [...yearMap.entries()]
  .sort(([a], [b]) => b.localeCompare(a))
  .map(([year, monthMap]) => ({
    year,
    months: [...monthMap.entries()]
      .sort(([a], [b]) => b - a)
      .map(([month, posts]) => ({
        month: monthNames[month],
        monthNum: month,
        posts: posts.sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime()),
      })),
  }));

const dateFormatter = new Intl.DateTimeFormat('zh-CN', { month: 'short', day: 'numeric' });
---

<BaseLayout title="归档" description="按时间浏览所有文章">
  <div class="container py-12 sm:py-16">
    <div>
      <header class="mb-10 border-b border-line pb-6">
        <p class="eyebrow">Archive</p>
        <h1 class="mt-2 text-3xl font-bold tracking-[-0.02em]">归档</h1>
        <p class="mt-2 text-sm text-muted">共 {sorted.length} 篇文章</p>
      </header>

      <div class="relative max-w-3xl">
        <!-- 时间轴线：left-14 (56px) -->
        <div class="absolute left-14 top-0 bottom-0 w-px bg-line" aria-hidden="true" />
        {years.map(({ year, months }) => (
          <div class="mb-10">
            <h2 class="sticky top-16 z-10 bg-paper pl-16 py-2 text-lg font-semibold text-ink mb-3 flex items-baseline gap-3">
              <span class="font-mono text-sm text-accent">{year}</span>
              <span class="text-sm font-normal text-faint">({months.reduce((s, m) => s + m.posts.length, 0)} 篇)</span>
            </h2>
            {months.map(({ month, posts }) => (
              <div class="mb-5">
                <h3 class="pl-16 py-1 font-mono text-xs uppercase tracking-[0.15em] text-faint">{month}</h3>
                <ul class="mt-1">
                  {posts.map((post) => (
                    <li class="group flex items-baseline gap-4 pl-16 py-2 relative">
                      <!-- 圆点：中心对齐 56px 竖线，右侧留出 5px 余量避免压到日期文字 -->
                      <span class="absolute left-[3.31rem] top-1/2 -translate-y-1/2 w-1.5 h-1.5 rounded-full bg-line group-hover:bg-accent transition-colors" aria-hidden="true" />
                      <span class="font-mono text-xs text-faint w-20 shrink-0 tabular-nums">{dateFormatter.format(post.pubDate)}</span>
                      <a href={`/blog/${post.slug}`}
                         class="text-ink group-hover:text-accent transition-colors line-clamp-1">
                        {post.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
