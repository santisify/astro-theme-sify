---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - 页面未找到">
  <div class="container py-24 sm:py-32">
    <div class="max-w-md mx-auto text-center">
      <p class="font-serif italic text-8xl text-accent">404</p>
      <p class="eyebrow mt-6">Page not found</p>
      <h1 class="mt-3 text-2xl font-semibold text-ink">页面不见了</h1>
      <p class="mt-3 text-muted">抱歉，你访问的页面可能已被删除或不存在。</p>
      <div class="mt-8 flex gap-3 justify-center">
        <a href="/" class="btn btn-primary">返回首页</a>
        <a href="/blog" class="btn btn-outline">去博客</a>
      </div>
    </div>
  </div>
</BaseLayout>
