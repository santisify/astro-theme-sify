---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import SeriesPost from '../../../layouts/SeriesPost.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('series');
  const paths = [];
  for (const post of allPosts) {
    const parts = post.id.split('/');
    if (parts.length > 1) {
      paths.push({ params: { slug: parts[0], order: post.data.order.toString() } });
    }
  }
  return paths;
}

const { slug, order } = Astro.params;
const allPosts = await getCollection('series');
const seriesPosts = allPosts.filter((p) => p.id.startsWith(`${slug}/`)).sort((a, b) => a.data.order - b.data.order);

if (seriesPosts.length === 0) return Astro.redirect('/404');

const post = seriesPosts.find((p) => p.data.order === parseInt(order, 10));
if (!post) return Astro.redirect(`/series/${slug}`);

const idx = seriesPosts.findIndex((p) => p.id === post.id);
const prev = seriesPosts[idx - 1];
const next = seriesPosts[idx + 1];
const first = seriesPosts[0];
const seriesInfo = { slug, title: first.data.title, description: first.data.description, posts: seriesPosts };
---

<SeriesPost post={post} seriesInfo={seriesInfo} prev={prev} next={next} />
